@@ -0,0 +1,21 @@
+import { theme } from "./theme";
+
+export interface PanelProps {
+  heading: string;
+  body: string;
+}
+
+export function Panel(props: PanelProps) {
+  return (
+    <section style={{ border: theme.border }}>
+      <h2>{props.heading}</h2>
+      <p>{props.body}</p>
+    </section>
+  );
+}
+
+export const PANEL_KIND = "spaceship";
+
+export function panelId(props: PanelProps): string {
+  return "panel:" + props.heading;
+}
